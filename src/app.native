<!-- Docyrus: native workspace chrome with local Monaco and @pierre/trees WebViews. -->
<template name="pane-actions" args="pane_id">
  <row height="20" gap="1" cross="center">
    <button width="20" height="20" size="sm" variant="ghost" icon="terminal" on-press="open_terminal_in:{pane_id}" label="Open terminal"></button>
    <button width="20" height="20" size="sm" variant="ghost" icon="arrow-down" on-press="split_horizontal:{pane_id}" label="Split horizontally"></button>
    <button width="20" height="20" size="sm" variant="ghost" icon="panel-right" on-press="split_vertical:{pane_id}" label="Split vertically"></button>
  </row>
</template>

<template name="leaf-pane-actions" args="pane_id">
  <row height="20" gap="1" cross="center">
    <button width="20" height="20" size="sm" variant="ghost" icon="terminal" on-press="open_terminal_in:{pane_id}" label="Open terminal"></button>
  </row>
</template>

<template name="workspace-tab" args="title tab_id icon_name selected dirty">
  <panel role="tab" radius="sm" selected="{selected}" on-press="activate_tab:{tab_id}" on-drag="drag_tab:{tab_id}" label="{title}">
    <row height="20" padding="3" gap="4" cross="center">
      <icon name="{icon_name}" width="12" height="12" />
      <text>{title}</text>
      <if test="{dirty}"><icon name="circle-dot" width="7" height="7" foreground="info" label="Unsaved changes" /></if>
      <button width="18" height="18" size="sm" variant="ghost" radius="sm" icon="x" on-press="close_tab:{tab_id}" label="Close {title}"></button>
    </row>
    <context-menu>
      <menu-item on-press="close_tab:{tab_id}">Close</menu-item>
      <menu-item on-press="close_other_tabs:{tab_id}">Close Others</menu-item>
      <menu-item on-press="close_all_tabs:{tab_id}">Close All</menu-item>
      <separator />
      <menu-item on-press="copy_path:{tab_id}">Copy Path</menu-item>
      <menu-item on-press="copy_relative_path:{tab_id}">Copy Relative Path</menu-item>
      <separator />
      <menu-item on-press="reveal_in_finder:{tab_id}">Reveal in Finder</menu-item>
    </context-menu>
  </panel>
</template>

<template name="empty-state" args="pane_id">
  <column grow="1" main="center" cross="center" gap="16" padding="32" label="Empty workspace">
    <icon name="file-text" width="40" height="40" foreground="text_muted" />
    <text size="heading">Start in the File Explorer</text>
    <text foreground="text_muted" text-alignment="center">Click a code or text file to edit it, a Markdown file to edit and preview it, or an image to preview it.</text>
    <row gap="8" cross="center">
      <button variant="secondary" icon="terminal" on-press="open_terminal_in:{pane_id}">Open Terminal</button>
      <button variant="secondary" icon="arrow-down" on-press="split_horizontal:{pane_id}">Split Horizontally</button>
      <button variant="secondary" icon="panel-right" on-press="split_vertical:{pane_id}">Split Vertically</button>
    </row>
  </column>
</template>

<template name="leaf-empty-state" args="pane_id">
  <column grow="1" main="center" cross="center" gap="16" padding="32" label="Empty workspace">
    <icon name="file-text" width="40" height="40" foreground="text_muted" />
    <text size="heading">Start in the File Explorer</text>
    <text foreground="text_muted" text-alignment="center">Open a file here by dragging its tab into this panel.</text>
    <button variant="secondary" icon="terminal" on-press="open_terminal_in:{pane_id}">Open Terminal</button>
  </column>
</template>

<template name="image-preview">
  <column grow="1" main="center" cross="center" gap="14" padding="28">
    <if test="{has_preview_image}">
      <image image="{preview_image}" width="360" height="360" label="Image preview" />
    </if>
    <else><text foreground="text_muted">Loading image preview...</text></else>
    <text size="heading">{preview_image_title}</text>
  </column>
</template>

<template name="primary-content">
  <column grow="1">
  <if test="{primary_is_markdown_active}">
    <row height="38" padding="6" gap="6" cross="center" background="surface">
      <text size="sm" foreground="text_muted">MARKDOWN</text>
      <spacer grow="1" />
      <toggle-group gap="4">
        <toggle-button size="sm" selected="{primary_markdown_editor_visible}" on-toggle="toggle_primary_markdown_editor" icon="edit">Editor</toggle-button>
        <toggle-button size="sm" selected="{primary_markdown_preview_visible}" on-toggle="toggle_primary_markdown_preview" icon="eye">Preview</toggle-button>
      </toggle-group>
    </row>
    <separator />
    <if test="{primary_markdown_editor_visible}">
      <if test="{primary_markdown_preview_visible}">
        <split grow="1" value="{markdown_fraction}" on-resize="markdown_resized" gap="1">
          <column min-width="300" grow="1" label="primary-editor-pane"></column>
          <scroll min-width="280" grow="1" background="surface_subtle">
            <column padding="24" gap="12"><markdown source="{primary_markdown_body}" /></column>
          </scroll>
        </split>
      </if>
      <else><column grow="1" label="primary-editor-pane"></column></else>
    </if>
    <else>
      <scroll min-width="280" grow="1" background="surface_subtle">
        <column padding="24" gap="12"><markdown source="{primary_markdown_body}" /></column>
      </scroll>
    </else>
  </if>
  <else>
    <if test="{primary_uses_editor}"><column grow="1" label="primary-editor-pane"></column></if>
    <else>
      <if test="{primary_is_image_active}"><use template="image-preview" /></if>
      <else>
        <if test="{primary_uses_terminal_one}">
          <terminal pty="{shell_key}" scrollback="{term_one_scrollback}" on-terminal="term_one_state" autofocus="true" grow="1" focus-ring="background" label="Project terminal one" />
        </if>
        <else>
          <if test="{primary_uses_terminal_two}">
            <terminal pty="{secondary_shell_key}" scrollback="{term_two_scrollback}" on-terminal="term_two_state" autofocus="true" grow="1" focus-ring="background" label="Project terminal two" />
          </if>
        </else>
      </else>
    </else>
  </else>
  </column>
</template>

<template name="secondary-content">
  <column grow="1">
  <if test="{secondary_is_markdown_active}">
    <row height="38" padding="6" gap="6" cross="center" background="surface">
      <text size="sm" foreground="text_muted">MARKDOWN</text>
      <spacer grow="1" />
      <toggle-group gap="4">
        <toggle-button size="sm" selected="{secondary_markdown_editor_visible}" on-toggle="toggle_secondary_markdown_editor" icon="edit">Editor</toggle-button>
        <toggle-button size="sm" selected="{secondary_markdown_preview_visible}" on-toggle="toggle_secondary_markdown_preview" icon="eye">Preview</toggle-button>
      </toggle-group>
    </row>
    <separator />
    <if test="{secondary_markdown_editor_visible}">
      <if test="{secondary_markdown_preview_visible}">
        <split grow="1" value="{markdown_fraction}" on-resize="markdown_resized" gap="1">
          <column min-width="260" grow="1" label="secondary-editor-pane"></column>
          <scroll min-width="240" grow="1" background="surface_subtle">
            <column padding="20" gap="12"><markdown source="{secondary_markdown_body}" /></column>
          </scroll>
        </split>
      </if>
      <else><column grow="1" label="secondary-editor-pane"></column></else>
    </if>
    <else>
      <scroll min-width="240" grow="1" background="surface_subtle">
        <column padding="20" gap="12"><markdown source="{secondary_markdown_body}" /></column>
      </scroll>
    </else>
  </if>
  <else>
    <if test="{secondary_uses_editor}"><column grow="1" label="secondary-editor-pane"></column></if>
    <else>
      <if test="{secondary_is_image_active}"><use template="image-preview" /></if>
      <else>
        <if test="{secondary_uses_terminal_one}">
          <terminal pty="{shell_key}" scrollback="{term_one_scrollback}" on-terminal="term_one_state" grow="1" focus-ring="background" label="Project terminal one" />
        </if>
        <else>
          <if test="{secondary_uses_terminal_two}">
            <terminal pty="{secondary_shell_key}" scrollback="{term_two_scrollback}" on-terminal="term_two_state" grow="1" focus-ring="background" label="Project terminal two" />
          </if>
        </else>
      </else>
    </else>
  </else>
  </column>
</template>

<template name="tertiary-content">
  <column grow="1">
  <if test="{tertiary_is_markdown_active}">
    <row height="38" padding="6" gap="6" cross="center" background="surface">
      <text size="sm" foreground="text_muted">MARKDOWN</text>
      <spacer grow="1" />
      <toggle-group gap="4">
        <toggle-button size="sm" selected="{tertiary_markdown_editor_visible}" on-toggle="toggle_tertiary_markdown_editor" icon="edit">Editor</toggle-button>
        <toggle-button size="sm" selected="{tertiary_markdown_preview_visible}" on-toggle="toggle_tertiary_markdown_preview" icon="eye">Preview</toggle-button>
      </toggle-group>
    </row>
    <separator />
    <if test="{tertiary_markdown_editor_visible}">
      <if test="{tertiary_markdown_preview_visible}">
        <split grow="1" value="{markdown_fraction}" on-resize="markdown_resized" gap="1">
          <column min-width="220" grow="1" label="tertiary-editor-pane"></column>
          <scroll min-width="220" grow="1" background="surface_subtle">
            <column padding="20" gap="12"><markdown source="{tertiary_markdown_body}" /></column>
          </scroll>
        </split>
      </if>
      <else><column grow="1" label="tertiary-editor-pane"></column></else>
    </if>
    <else>
      <scroll min-width="220" grow="1" background="surface_subtle">
        <column padding="20" gap="12"><markdown source="{tertiary_markdown_body}" /></column>
      </scroll>
    </else>
  </if>
  <else>
    <if test="{tertiary_uses_editor}"><column grow="1" label="tertiary-editor-pane"></column></if>
    <else>
      <if test="{tertiary_is_image_active}"><use template="image-preview" /></if>
      <else>
        <if test="{tertiary_uses_terminal_one}">
          <terminal pty="{shell_key}" scrollback="{term_one_scrollback}" on-terminal="term_one_state" grow="1" focus-ring="background" label="Project terminal one" />
        </if>
        <else>
          <if test="{tertiary_uses_terminal_two}">
            <terminal pty="{secondary_shell_key}" scrollback="{term_two_scrollback}" on-terminal="term_two_state" grow="1" focus-ring="background" label="Project terminal two" />
          </if>
        </else>
      </else>
    </else>
  </else>
  </column>
</template>

<template name="quaternary-content">
  <column grow="1">
  <if test="{quaternary_is_markdown_active}">
    <row height="38" padding="6" gap="6" cross="center" background="surface">
      <text size="sm" foreground="text_muted">MARKDOWN</text>
      <spacer grow="1" />
      <toggle-group gap="4">
        <toggle-button size="sm" selected="{quaternary_markdown_editor_visible}" on-toggle="toggle_quaternary_markdown_editor" icon="edit">Editor</toggle-button>
        <toggle-button size="sm" selected="{quaternary_markdown_preview_visible}" on-toggle="toggle_quaternary_markdown_preview" icon="eye">Preview</toggle-button>
      </toggle-group>
    </row>
    <separator />
    <if test="{quaternary_markdown_editor_visible}">
      <if test="{quaternary_markdown_preview_visible}">
        <split grow="1" value="{markdown_fraction}" on-resize="markdown_resized" gap="1">
          <column min-width="220" grow="1" label="quaternary-editor-pane"></column>
          <scroll min-width="220" grow="1" background="surface_subtle">
            <column padding="20" gap="12"><markdown source="{quaternary_markdown_body}" /></column>
          </scroll>
        </split>
      </if>
      <else><column grow="1" label="quaternary-editor-pane"></column></else>
    </if>
    <else>
      <scroll min-width="220" grow="1" background="surface_subtle">
        <column padding="20" gap="12"><markdown source="{quaternary_markdown_body}" /></column>
      </scroll>
    </else>
  </if>
  <else>
    <if test="{quaternary_uses_editor}"><column grow="1" label="quaternary-editor-pane"></column></if>
    <else>
      <if test="{quaternary_is_image_active}"><use template="image-preview" /></if>
      <else>
        <if test="{quaternary_uses_terminal_one}">
          <terminal pty="{shell_key}" scrollback="{term_one_scrollback}" on-terminal="term_one_state" grow="1" focus-ring="background" label="Project terminal one" />
        </if>
        <else>
          <if test="{quaternary_uses_terminal_two}">
            <terminal pty="{secondary_shell_key}" scrollback="{term_two_scrollback}" on-terminal="term_two_state" grow="1" focus-ring="background" label="Project terminal two" />
          </if>
        </else>
      </else>
    </else>
  </else>
  </column>
</template>

<template name="primary-pane">
  <column grow="1" background="background" label="Primary tab panel">
    <tabs height="24" padding="2" gap="1" background="surface" label="Primary tabs">
      <for each="primaryTabs" key="id" as="tab">
        <use template="workspace-tab" title="{tab.title}" tab_id="{tab.id}" icon_name="{tab.icon}" selected="{tab.selected}" dirty="{tab.dirty}" />
      </for>
      <spacer grow="1" />
      <if test="{primary_can_split}"><use template="pane-actions" pane_id="1" /></if>
      <else><use template="leaf-pane-actions" pane_id="1" /></else>
    </tabs>
    <separator />
    <if test="{primary_has_tabs}">
      <use template="primary-content" />
      <status-bar height="24" padding="4" size="sm">{primary_status_text}</status-bar>
    </if>
    <else>
      <if test="{primary_can_split}"><use template="empty-state" pane_id="1" /></if>
      <else><use template="leaf-empty-state" pane_id="1" /></else>
    </else>
  </column>
</template>

<template name="secondary-pane">
  <column grow="1" background="background" label="Secondary tab panel">
    <tabs height="24" padding="2" gap="1" background="surface" label="Secondary tabs">
      <for each="secondaryTabs" key="id" as="tab">
        <use template="workspace-tab" title="{tab.title}" tab_id="{tab.id}" icon_name="{tab.icon}" selected="{tab.selected}" dirty="{tab.dirty}" />
      </for>
      <spacer grow="1" />
      <if test="{secondary_can_split}"><use template="pane-actions" pane_id="2" /></if>
      <else><use template="leaf-pane-actions" pane_id="2" /></else>
    </tabs>
    <separator />
    <if test="{secondary_has_tabs}">
      <use template="secondary-content" />
      <status-bar height="24" padding="4" size="sm">{secondary_status_text}</status-bar>
    </if>
    <else>
      <if test="{secondary_can_split}"><use template="empty-state" pane_id="2" /></if>
      <else><use template="leaf-empty-state" pane_id="2" /></else>
    </else>
  </column>
</template>

<template name="tertiary-pane">
  <column grow="1" background="background" label="Tertiary tab panel">
    <tabs height="24" padding="2" gap="1" background="surface" label="Tertiary tabs">
      <for each="tertiaryTabs" key="id" as="tab">
        <use template="workspace-tab" title="{tab.title}" tab_id="{tab.id}" icon_name="{tab.icon}" selected="{tab.selected}" dirty="{tab.dirty}" />
      </for>
      <spacer grow="1" />
      <use template="leaf-pane-actions" pane_id="3" />
    </tabs>
    <separator />
    <if test="{tertiary_has_tabs}">
      <use template="tertiary-content" />
      <status-bar height="24" padding="4" size="sm">{tertiary_status_text}</status-bar>
    </if>
    <else><use template="leaf-empty-state" pane_id="3" /></else>
  </column>
</template>

<template name="quaternary-pane">
  <column grow="1" background="background" label="Quaternary tab panel">
    <tabs height="24" padding="2" gap="1" background="surface" label="Quaternary tabs">
      <for each="quaternaryTabs" key="id" as="tab">
        <use template="workspace-tab" title="{tab.title}" tab_id="{tab.id}" icon_name="{tab.icon}" selected="{tab.selected}" dirty="{tab.dirty}" />
      </for>
      <spacer grow="1" />
      <use template="leaf-pane-actions" pane_id="4" />
    </tabs>
    <separator />
    <if test="{quaternary_has_tabs}">
      <use template="quaternary-content" />
      <status-bar height="24" padding="4" size="sm">{quaternary_status_text}</status-bar>
    </if>
    <else><use template="leaf-empty-state" pane_id="4" /></else>
  </column>
</template>

<template name="primary-branch">
  <column min-width="280" grow="{split_fraction}" background="background" label="Primary split branch">
    <if test="{primary_child_open}">
      <if test="{primary_child_mode == 'vertical'}">
        <split grow="1" value="{primary_child_fraction}" on-resize="primary_child_resized" gap="1">
          <column min-width="140" grow="{primary_child_fraction}"><use template="primary-pane" /></column>
          <column min-width="140" grow="{primary_child_secondary_fraction}"><use template="tertiary-pane" /></column>
        </split>
      </if>
      <else>
        <column grow="1" background="background" label="Primary branch horizontal split">
          <column grow="{primary_child_fraction}"><use template="primary-pane" /></column>
          <row height="9" main="center" cross="center" on-drag="primary_branch_horizontal_split_dragged:{active_project_id}" role="separator" label="Primary branch horizontal divider">
            <separator grow="1" height="1" />
          </row>
          <column grow="{primary_child_secondary_fraction}"><use template="tertiary-pane" /></column>
        </column>
      </else>
    </if>
    <else><use template="primary-pane" /></else>
  </column>
</template>

<template name="secondary-branch">
  <column min-width="280" grow="{secondary_split_fraction}" background="background" label="Secondary split branch">
    <if test="{secondary_child_open}">
      <if test="{secondary_child_mode == 'vertical'}">
        <split grow="1" value="{secondary_child_fraction}" on-resize="secondary_child_resized" gap="1">
          <column min-width="140" grow="{secondary_child_fraction}"><use template="secondary-pane" /></column>
          <column min-width="140" grow="{secondary_child_secondary_fraction}"><use template="quaternary-pane" /></column>
        </split>
      </if>
      <else>
        <column grow="1" background="background" label="Secondary branch horizontal split">
          <column grow="{secondary_child_fraction}"><use template="secondary-pane" /></column>
          <row height="9" main="center" cross="center" on-drag="secondary_branch_horizontal_split_dragged:{active_project_id}" role="separator" label="Secondary branch horizontal divider">
            <separator grow="1" height="1" />
          </row>
          <column grow="{secondary_child_secondary_fraction}"><use template="quaternary-pane" /></column>
        </column>
      </else>
    </if>
    <else><use template="secondary-pane" /></else>
  </column>
</template>

<template name="horizontal-workspace-split">
  <column grow="1" background="background" label="Horizontal workspace split">
    <use template="primary-branch" />
    <row height="9" main="center" cross="center" on-drag="horizontal_split_dragged:{active_project_id}" role="separator" label="Horizontal split divider">
      <separator grow="1" height="1" />
    </row>
    <use template="secondary-branch" />
  </column>
</template>

<template name="workspace">
  <column grow="1" background="background" label="Workspace">
    <if test="{secondary_panel_open}">
      <if test="{split_mode == 'vertical'}">
        <split grow="1" value="{split_fraction}" on-resize="split_resized" gap="1">
          <use template="primary-branch" />
          <use template="secondary-branch" />
        </split>
      </if>
      <else>
        <use template="horizontal-workspace-split" />
      </else>
    </if>
    <else><use template="primary-branch" /></else>
  </column>
</template>

<column grow="1" background="background">
  <row height="42" padding="8" gap="8" cross="center" background="surface" window-drag="true">
    <row width="64"></row>
    <button size="sm" variant="ghost" icon="plus" on-press="open_add_project" label="Add project folder"></button>
    <button size="sm" variant="ghost" icon="panel-left" on-press="toggle_explorer" label="Toggle Explorer"></button>
    <text>DOCYRUS</text>
    <badge variant="secondary">OPEN IDE</badge>
    <spacer grow="1" />
    <text foreground="text_muted">{workspace_path}</text>
    <button size="sm" variant="ghost" icon="settings" on-press="open_settings" label="Settings"></button>
  </row>
  <separator />

  <if test="{has_projects}">
  <split grow="1" value="{project_sidebar_fraction}" on-resize="project_sidebar_resized" gap="1">
    <column min-width="160" max-width="360" background="surface_subtle" label="Project Folders">
      <scroll grow="1">
        <column padding="6" gap="4">
          <for each="openProjects" key="id" as="project">
            <panel height="56" role="button" selected="{project.selected}" on-press="select_project:{project.id}" on-drag="drag_project:{project.id}" on-hover-enter="hover_project:{project.id}" on-hover-leave="leave_project:{project.id}" label="{project.path}">
              <row padding="6" gap="4" cross="start">
                <column grow="1" gap="3" cross="start">
                  <text wrap="false" overflow="ellipsis">{project.name}</text>
                  <text size="sm" wrap="false" overflow="ellipsis" foreground="text_muted">{project.display_path}</text>
                </column>
                <if test="{project.show_actions}">
                  <stack width="22" height="20">
                    <button width="22" height="20" size="sm" variant="ghost" radius="sm" icon="ellipsis" on-press="toggle_project_menu:{project.id}" label="Project actions"></button>
                    <if test="{project.actions_open}">
                      <dropdown-menu anchor="below" anchor-alignment="end" on-dismiss="close_project_menu">
                        <menu-item on-press="close_project:{project.id}">Close</menu-item>
                        <menu-item on-press="remove_project:{project.id}">Remove</menu-item>
                        <menu-item on-press="begin_rename_project:{project.id}">Rename</menu-item>
                      </dropdown-menu>
                    </if>
                  </stack>
                </if>
              </row>
            </panel>
          </for>
        </column>
      </scroll>
    </column>

    <row grow="1">
      <if test="{explorer_open}">
        <split grow="1" value="{explorer_fraction}" on-resize="explorer_resized" gap="1">
          <column min-width="196" max-width="360" background="surface_subtle">
            <row height="24" padding="4" gap="4" cross="center">
              <text grow="1">EXPLORER</text>
              <button width="20" height="20" size="sm" variant="ghost" radius="sm" icon="refresh-cw" on-press="refresh_files" label="Refresh files"></button>
              <button width="20" height="20" size="sm" variant="ghost" radius="sm" icon="panel-left" on-press="toggle_explorer" label="Collapse explorer"></button>
            </row>
            <separator />
            <row height="34" padding="8" gap="6" cross="center" background="surface">
              <icon name="folder-open" width="15" height="15" />
              <text grow="1">{project_name}</text>
            </row>
            <column grow="1" label="file-tree-pane"></column>
          </column>
          <use template="workspace" />
        </split>
      </if>
      <else><use template="workspace" /></else>
    </row>
  </split>
  </if>

  <if test="{rename_project_open}">
    <dialog label="Rename project" on-dismiss="cancel_rename_project">
      <column width="500" height="246" padding="24" gap="18">
        <column gap="6">
          <text size="heading">Rename project</text>
          <text foreground="text_muted" wrap="true">This changes only the project name shown in Docyrus Open IDE. The folder name and path stay unchanged.</text>
        </column>
        <text-field text="{rename_project_text}" on-input="rename_project_input" on-submit="confirm_rename_project" autofocus="true" label="Project display name" />
        <spacer grow="1" />
        <row main="end" gap="8">
          <button variant="ghost" on-press="cancel_rename_project">Cancel</button>
          <button variant="primary" on-press="confirm_rename_project">Rename</button>
        </row>
      </column>
    </dialog>
  </if>

  <if test="{add_project_open}">
    <dialog label="Add project folder" on-dismiss="close_add_project">
      <column width="560" height="460" padding="24" gap="14">
        <column gap="6">
          <text size="heading">Add project folder</text>
          <text foreground="text_muted" wrap="true">Choose a directory, or reopen one of your recent projects.</text>
        </column>
        <button variant="primary" icon="folder" on-press="choose_project_directory">Choose Folder...</button>
        <separator />
        <text>RECENT PROJECTS</text>
        <if test="{has_recent_projects}">
          <scroll grow="1">
            <column gap="4">
              <for each="recentProjects" key="id" as="recent">
                <panel role="button" on-press="open_recent_project:{recent.id}" label="{recent.path}">
                  <row padding="6" gap="8" cross="center">
                    <column grow="1" gap="2" cross="start">
                      <text>{recent.name}</text>
                      <text foreground="text_muted">{recent.path}</text>
                    </column>
                    <button width="24" height="24" size="sm" variant="ghost" radius="sm" icon="x" on-press="remove_recent_project:{recent.id}" label="Remove {recent.name} from recent projects"></button>
                  </row>
                </panel>
              </for>
            </column>
          </scroll>
        </if>
        <else><text foreground="text_muted">No recent projects yet.</text></else>
        <if test="{has_projects}">
          <row main="end"><button variant="ghost" on-press="close_add_project">Cancel</button></row>
        </if>
      </column>
    </dialog>
  </if>

  <if test="{close_confirmation_open}">
    <dialog label="Unsaved changes" on-dismiss="cancel_close_tab">
      <column width="520" height="224" padding="24" gap="18">
        <column gap="6">
          <text size="heading">Save changes to {pending_close_title}?</text>
          <text foreground="text_muted" wrap="true">Your changes will be lost if you close this editor without saving.</text>
        </column>
        <spacer grow="1" />
        <row main="end" gap="8">
          <button variant="primary" on-press="save_and_close_tab">Save and Close</button>
          <button variant="secondary" on-press="discard_and_close_tab">Close</button>
          <button variant="ghost" on-press="cancel_close_tab">Cancel</button>
        </row>
      </column>
    </dialog>
  </if>

  <if test="{settings_open}">
    <dialog label="Settings" on-dismiss="close_settings">
      <column width="480" height="236" padding="24" gap="18">
        <column gap="6">
          <text size="heading">Settings</text>
          <text foreground="text_muted">Choose how Docyrus Open IDE should appear.</text>
        </column>
        <column gap="8">
          <text>Theme</text>
          <row gap="6">
            <button selected="{theme_dark_selected}" on-press="set_theme_dark">Dark Mode</button>
            <button selected="{theme_light_selected}" on-press="set_theme_light">Light Mode</button>
            <button selected="{theme_system_selected}" on-press="set_theme_system">System Default</button>
          </row>
        </column>
        <row main="end"><button variant="primary" on-press="close_settings">Done</button></row>
      </column>
    </dialog>
  </if>
</column>
