# Vendored Monaco build — not our source, keep it out of diffs and language stats.
frontend/dist/vs/**            linguist-vendored -diff

# Generated by `npm run bundle:tree` from frontend/tree.js. Never hand-edit.
frontend/dist/tree.js          linguist-generated -diff

# Binary assets
*.png                          binary
*.icns                         binary

# Keep shell scripts LF on every platform
*.sh                           text eol=lf
